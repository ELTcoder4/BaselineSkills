<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %></title><link rel="icon" type="image/png" href="/img/favicon.png"><link rel="stylesheet" href="/css/style.css"></head>
<body>
<div class="login-shell">
  <div class="login-card">
    <div class="brand" style="justify-content:center;margin-bottom:20px">Baseline Skills</div>
    <h3 style="text-align:center">Admin sign in</h3>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <div class="form-field"><label>Password</label><input type="password" name="password" required autofocus></div>
      <button type="submit" class="btn btn-navy btn-block">Sign in</button>
    </form>
    <p class="form-hint" style="text-align:center;margin-top:14px">Default password is <code>changeme123</code> unless <code>ADMIN_PASSWORD</code> is set.</p>
  </div>
</div>
</body>
</html>
