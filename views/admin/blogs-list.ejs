<%- include('partials/head') %>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
  <h1 style="font-size:1.6rem;margin:0">Blog posts</h1>
  <a href="/admin/blogs/new" class="btn btn-gold">+ New post</a>
</div>

<table class="admin-table">
  <thead><tr><th>Title</th><th>Category</th><th>Author</th><th>Status</th><th>Actions</th></tr></thead>
  <tbody>
    <% blogs.forEach(b => { %>
    <tr>
      <td><strong><%= b.title %></strong></td>
      <td><%= b.category %></td>
      <td><%= b.author %></td>
      <td><span class="badge <%= b.published?'badge-published':'badge-draft' %>"><%= b.published?'Published':'Draft' %></span></td>
      <td class="admin-actions">
        <% if (b.published) { %><a href="/blog/<%= b.slug %>" target="_blank" class="btn btn-outline btn-sm">View</a><% } %>
        <a href="/admin/blogs/<%= b.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
        <form method="POST" action="/admin/blogs/<%= b.id %>/toggle-published" style="display:inline"><button class="btn btn-outline btn-sm" type="submit"><%= b.published?'Unpublish':'Publish' %></button></form>
        <form method="POST" action="/admin/blogs/<%= b.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this post permanently?')"><button class="btn btn-outline btn-sm" type="submit" style="color:#b91c1c;border-color:#fecaca">Delete</button></form>
      </td>
    </tr>
    <% }) %>
    <% if (blogs.length===0) { %><tr><td colspan="5" style="color:var(--muted)">No blog posts yet.</td></tr><% } %>
  </tbody>
</table>

<%- include('partials/foot') %>
