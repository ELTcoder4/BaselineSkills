<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %></title><link rel="icon" type="image/png" href="/img/favicon.png"><link rel="stylesheet" href="/css/style.css"></head>
<body>
<div class="admin-shell">
 <aside class="admin-sidebar" id="adminSidebar">
  <div class="sidebar-header">
    <a href="/admin" class="sidebar-brand">
      <span class="brand-logo">B</span>
      <span class="brand-text">
        <strong>Baseline</strong>
        <small>Skills Admin</small>
      </span>
    </a>

    <button
      type="button"
      class="sidebar-collapse-btn"
      id="sidebarCollapseBtn"
      aria-label="Collapse sidebar"
      title="Collapse sidebar"
    >
      
    </button>
  </div>

  <div class="sidebar-label">Workspace</div>

  <nav class="admin-nav" aria-label="Admin navigation">
    <a
      href="/admin"
      class="<%= currentPath === '/admin' ? 'active' : '' %>"
      title="Dashboard"
    >
      <span class="nav-icon">⌂</span>
      <span class="nav-text">Dashboard</span>
    </a>

    <a
      href="/admin/courses"
      class="<%= currentPath.startsWith('/admin/courses') ? 'active' : '' %>"
      title="Courses"
    >
      <span class="nav-icon">▦</span>
      <span class="nav-text">Courses</span>
    </a>

    <a
      href="/admin/trainers"
      class="<%= currentPath.startsWith('/admin/trainers') ? 'active' : '' %>"
      title="Trainers"
    >
      <span class="nav-icon">◎</span>
      <span class="nav-text">Trainers</span>
    </a>

    <a
      href="/admin/blogs"
      class="<%= currentPath.startsWith('/admin/blogs') ? 'active' : '' %>"
      title="Blog"
    >
      <span class="nav-icon">▤</span>
      <span class="nav-text">Blog</span>
    </a>

    <a
      href="/admin/resources"
      class="<%= currentPath.startsWith('/admin/resources') ? 'active' : '' %>"
      title="Resources"
    >
      <span class="nav-icon">↗</span>
      <span class="nav-text">Resources</span>
    </a>

    <a
      href="/admin/registrations"
      class="<%= currentPath === '/admin/registrations' ? 'active' : '' %>"
      title="Registrations"
    >
      <span class="nav-icon">✓</span>
      <span class="nav-text">Registrations</span>
    </a>

    <a
      href="/admin/inquiries"
      class="<%= currentPath === '/admin/inquiries' ? 'active' : '' %>"
      title="Inquiries"
    >
      <span class="nav-icon">✉</span>
      <span class="nav-text">Inquiries</span>
    </a>
  </nav>

  <div class="sidebar-footer">
    <a href="/" target="_blank" rel="noopener" title="View live site">
      <span class="nav-icon">↗</span>
      <span class="nav-text">View live site</span>
    </a>

    <a href="/admin/logout" title="Sign out">
      <span class="nav-icon">→</span>
      <span class="nav-text">Sign out</span>
    </a>
  </div>
</aside>

<main class="admin-main">
  <header class="admin-topbar">
    <button
      type="button"
      class="sidebar-mobile-toggle"
      aria-label="Open navigation"
    >
      ☰
    </button>

    <div class="topbar-context">
      <span class="topbar-kicker">Workspace</span>
      <span class="topbar-title">Admin portal</span>
    </div>

    <div class="admin-user">
      <span class="user-avatar">A</span>
      <span>
        <strong>Administrator</strong>
        <small>Content manager</small>
      </span>
    </div>
  </header>

  <div class="admin-content">
