<%- include('partials/head') %>

<div class="page-heading">
  <div>
    <h1>Resources (RE Pulse)</h1>
    <p>Manage curated industry publications, templates, tools, and guides.</p>
  </div>

  <a href="/admin/resources/new" class="btn btn-gold btn-animated-shine">
    <span class="btn-icon">+</span>
    <span>New resource</span>
  </a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error" style="margin-bottom:16px"><%= error %></div>
<% } %>

<div class="course-toolbar">
  <div class="course-count">
    <strong><%= resources.length %></strong>
    resource<%= resources.length === 1 ? '' : 's' %>
  </div>

  <input
    type="search"
    id="resourceSearch"
    class="course-search"
    placeholder="Search resources..."
    aria-label="Search resources"
  >
</div>

<div class="table-card course-table-card">
  <div class="table-scroll">
    <table class="admin-table showcase-table" id="resourcesTable">
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Link</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% resources.forEach((r, index) => { %>
          <tr class="activity-row" style="--row-index: <%= index %>">
            <td data-label="Title" class="course-title-cell">
              <strong class="table-title-main"><%= r.title %></strong>
              <% if (r.excerpt) { %>
                <small class="table-title-sub"><%= r.excerpt %></small>
              <% } %>
            </td>

            <td data-label="Category">
              <span class="course-category">
                <%= r.category %>
              </span>
            </td>

            <td data-label="Link">
              <a href="<%= r.url %>" target="_blank" rel="noopener" class="table-ext-link">
                <span class="link-url-text"><%= r.url %></span>
                <span class="link-ext-icon">↗</span>
              </a>
            </td>

            <td data-label="Actions" class="admin-actions">
              <a
                href="/admin/resources/<%= r.id %>/edit"
                class="btn-action btn-action-edit"
                title="Edit resource"
              >
                <span class="btn-action-icon">✎</span>
                <span>Edit</span>
              </a>

              <form
                method="POST"
                action="/admin/resources/<%= r.id %>/delete"
                onsubmit="return confirm('Delete this resource permanently?')"
                style="display:inline"
              >
                <button
                  class="btn-action btn-action-delete"
                  type="submit"
                  title="Delete resource"
                >
                  <span class="btn-action-icon">🗑</span>
                  <span>Delete</span>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>

        <% if (resources.length === 0) { %>
          <tr>
            <td colspan="4" class="empty-state">
              No resources yet — add your first resource.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  const searchInput = document.querySelector("#resourceSearch");
  const tableRows = document.querySelectorAll("#resourcesTable tbody tr");

  searchInput?.addEventListener("input", () => {
    const searchTerm = searchInput.value.toLowerCase().trim();

    tableRows.forEach((row) => {
      const rowText = row.textContent.toLowerCase();

      row.style.display = rowText.includes(searchTerm)
        ? ""
        : "none";
    });
  });
</script>

<%- include('partials/foot') %>
