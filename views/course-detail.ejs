<%- include('partials/header') %>

<section class="course-header">
  <div class="container">
    <span class="tag"><%= course.category %></span>
    <% if(course.certification){ %><span class="tag" style="margin-left:8px">Certification</span><% } %>
    <h1 style="color:#fff;margin-top:14px"><%= course.title %></h1>
    <p style="color:rgba(255,255,255,.8);max-width:640px"><%= course.summary %></p>
    <div class="course-meta">
      <span><strong><%= course.durationDays %></strong> Day<%= course.durationDays>1?'s':'' %></span>
      <span><strong><%= course.deliveryModes.join(', ') %></strong></span>
      <span><strong><%= course.sessions.length %></strong> upcoming session<%= course.sessions.length!==1?'s':'' %></span>
    </div>
    <a href="/courses/<%= course.slug %>/register" class="btn btn-gold btn-lg">Register Now</a>
  </div>
</section>

<div class="container course-body">
  <div>
    <h2>What You'll Learn</h2>
    <ul style="padding-left:20px;color:var(--text)">
      <% course.outcomes.forEach(o => { %><li style="margin-bottom:8px"><%= o %></li><% }) %>
    </ul>

    <h2 style="margin-top:36px">Course Overview</h2>
    <p style="white-space:pre-line;color:var(--text)"><%= course.description %></p>

    <% if (course.curriculum && course.curriculum.length) { %>
    <h2 style="margin-top:36px">Detailed Curriculum</h2>
    <% course.curriculum.forEach((mod, i) => { %>
      <div class="accordion-item <%= i===0?'open':'' %>">
        <button class="accordion-btn" onclick="this.parentElement.classList.toggle('open')">
          <span><%= mod.module %></span><span>&#9662;</span>
        </button>
        <div class="accordion-panel">
          <ul style="padding-left:18px">
            <% mod.topics.forEach(t => { %><li><%= t %></li><% }) %>
          </ul>
        </div>
      </div>
    <% }) %>
    <% } %>

    <h2 style="margin-top:36px">Who Should Attend</h2>
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      <% course.audience.forEach(a => { %><span class="pill"><%= a %></span><% }) %>
    </div>

    <h2 style="margin-top:36px">Delivery Options</h2>
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      <% course.deliveryModes.forEach(m => { %><span class="pill"><%= m %></span><% }) %>
    </div>

    <% if (related.length) { %>
    <h2 style="margin-top:36px">Related Courses</h2>
    <div class="grid-3">
      <% related.forEach(r => { %>
        <div class="card">
          <h4><%= r.title %></h4>
          <p style="font-size:.85rem;color:var(--muted);flex:1"><%= r.summary %></p>
          <a href="/courses/<%= r.slug %>" class="btn btn-outline btn-sm">Learn More</a>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <div>
    <div class="sticky-card" id="sessions">
      <div class="price-row">
        <div class="price-now">$<%= ((course.priceCents*(1-(course.discountPercent||0)/100))/100).toFixed(0) %></div>
        <% if(course.discountPercent){ %><div class="price-was">$<%= (course.priceCents/100).toFixed(0) %></div><% } %>
      </div>
      <% if(course.discountPercent){ %><span class="discount-badge"><%= course.discountPercent %>% OFF</span><% } %>
      <p class="form-hint" style="margin-top:10px">per person &middot; <%= course.currency %></p>
      <a href="/courses/<%= course.slug %>/register" class="btn btn-gold btn-block" style="margin-top:14px">Register Now</a>
      <a href="/contact" class="btn btn-outline btn-block" style="margin-top:10px">Corporate Inquiry</a>

      <h4 style="margin-top:24px;font-size:.95rem">Upcoming Sessions</h4>
      <ul class="session-list">
        <% course.sessions.forEach(s => { %>
          <li><span><%= s.startDate %> &middot; <%= s.mode %></span><span><%= s.seatsLeft!=null ? s.seatsLeft+' seats left' : 'On request' %></span></li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
