<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="icon" type="image/png" href="/img/favicon.png">
<link rel="stylesheet" href="/css/style.css">
<script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
</head>
<body>
<section class="section" style="min-height:70vh;display:flex;align-items:center;justify-content:center">
  <div class="container" style="max-width:520px;text-align:center">
    <h1 style="font-size:1.6rem">Completing your registration for<br><%= course.title %></h1>
    <p class="lead">Loading secure checkout…</p>
    <div id="checkout-fallback" style="display:none;margin-top:20px">
      <p>The checkout window didn't open automatically.</p>
      <button class="btn btn-gold" onclick="openCheckout()">Open checkout</button>
    </div>
    <p class="form-hint" style="margin-top:24px"><a href="/register/cancel?reg=<%= registration.id %>">Cancel and go back</a></p>
  </div>
</section>

<script>
  Paddle.Environment.set("<%= clientConfig.environment %>");
  Paddle.Initialize({
    token: "<%= clientConfig.clientToken %>",
    eventCallback: function (e) {
      if (e.name === "checkout.completed") {
        window.location.href = "/register/success?reg=<%= registration.id %>";
      }
      if (e.name === "checkout.closed" && !e.data) {
        // closed without completing — send them to the cancel page
        window.location.href = "/register/cancel?reg=<%= registration.id %>";
      }
    },
  });

  function openCheckout() {
    Paddle.Checkout.open({
      transactionId: "<%= registration.paddleTransactionId %>",
      settings: {
        displayMode: "overlay",
        theme: "light",
        successUrl: window.location.origin + "/register/success?reg=<%= registration.id %>",
      },
    });
  }

  // Open automatically; show a manual button if the overlay fails to load
  // (e.g., an ad-blocker or content blocker interfering).
  openCheckout();
  setTimeout(function () {
    document.getElementById("checkout-fallback").style.display = "block";
  }, 3000);
</script>
</body>
</html>
