<%- include('partials/header') %>

<!-- Hero Section with Animated Headline, Core Trainer Card & Featured Card -->
<section class="hero hero-enhanced">
  <div class="hero-bg-mesh" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-content-col">
      <div class="hero-badge-pill animate-fade-in">
        <span class="badge-sparkle">✨</span>
        <span class="badge-text">Industry-Standard Professional Engineering Excellence</span>
      </div>

      <!-- Exact Primary Hero Heading -->
      <h1 class="hero-title animate-title">
        Master Requirement Engineering, Systems Engineering &amp; AI skill - That Drive Better Product
      </h1>

      <p class="hero-subtitle animate-fade-in delay-1">
        Build practical, globally accredited engineering capability with industry-recognized IREB, INCOSE, and ASPICE certified practitioners. Transform complex requirements into successful high-integrity products.
      </p>

      <div class="hero-ctas animate-fade-in delay-2">
        <a href="/courses" class="btn btn-gold btn-lg btn-glow">
          <span>Explore Courses</span>
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <button type="button" class="btn btn-outline-light btn-lg btn-expert-hero" onclick="openExpertModal()">
          <span class="cta-pulse-dot"></span>
          <span>Talk to Expert</span>
        </button>
      </div>

      <!-- CORE Professional Trainer Card -->
      <div class="core-trainer-card animate-fade-in delay-3">
        <div class="trainer-card-header">
          <div class="trainer-avatar-ring">
            <span class="trainer-icon">👨‍🏫</span>
            <span class="trainer-verified-badge" title="Verified Senior Trainer">✓</span>
          </div>
          <div class="trainer-meta">
            <div class="trainer-title-wrap">
              <span class="trainer-kicker">Faculty Spotlight</span>
              <h4 class="trainer-headline">CORE Professional Trainer</h4>
            </div>
            <p class="trainer-desc">Accredited practitioners with extensive automotive, aerospace, and digital transformation delivery.</p>
          </div>
        </div>

        <div class="trainer-stats-grid">
          <div class="trainer-stat-pill">
            <span class="stat-highlight">17+ yrs</span>
            <span class="stat-caption">Industry &amp; Training Leadership</span>
          </div>
          <div class="trainer-stat-pill">
            <span class="stat-highlight">Corporate</span>
            <span class="stat-caption">Tailored Org Programs</span>
          </div>
          <div class="trainer-stat-pill">
            <span class="stat-highlight">Live</span>
            <span class="stat-caption">Cohort-Based Workshops</span>
          </div>
          <div class="trainer-stat-pill">
            <span class="stat-highlight">Online</span>
            <span class="stat-caption">Interactive Global Labs</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right-Aligned Featured Course Card -->
    <div class="hero-featured-col animate-float-right">
      <div class="featured-card-wrapper">
        <div class="featured-card-glow"></div>
        <div class="hero-card featured-course-card">
          <div class="featured-top-bar">
            <span class="tag-featured">⭐ Featured Certification</span>
            <span class="tag-live-indicator"><span class="pulse-green"></span> Live Interactive</span>
          </div>
          <div class="featured-seal-badge">IREB CPRE</div>
          <h3 class="featured-course-title">IREB CPRE Foundation Level</h3>
          <p class="featured-course-summary">The internationally recognized benchmark for requirement engineering excellence, aligned to the official IREB syllabus.</p>
          
          <div class="featured-perks-list">
            <div class="perk-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Official Syllabi &amp; Real Project Case Studies</span>
            </div>
            <div class="perk-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>100% Exam Pass-Rate Preparation Guarantee</span>
            </div>
            <div class="perk-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>4-Day Intensive with Senior RE Lead</span>
            </div>
          </div>

          <div class="featured-bottom-action">
            <div class="featured-price-box">
              <span class="price-kicker">Next Batch Starting Soon</span>
              <span class="price-val">$899</span>
            </div>
            <a href="/courses/cpre-foundation-level" class="btn btn-navy btn-sm btn-featured-cta">
              <span>View Course</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Core Domain Grid Section (Smooth entrance & hover animations) -->
<section class="section domain-grid-section" id="core-domains">
  <div class="container">
    <div class="section-hdr center">
      <span class="eyebrow">Core Engineering Domains</span>
      <h2>Specialized Capabilities Designed for High-Impact Engineers</h2>
      <p class="lead">Select your discipline to explore industry-aligned certifications, tool mastery, and hands-on curriculums.</p>
    </div>

    <div class="domain-cards-grid">
      <!-- 1. Requirement Engineering -->
      <div class="domain-card domain-re" onclick="window.location.href='/courses?category=Requirements%20Engineering'">
        <div class="domain-card-accent"></div>
        <div class="domain-card-body">
          <div class="domain-icon-wrap">
            <span class="domain-icon-symbol">📐</span>
          </div>
          <span class="domain-kicker">Global Standard</span>
          <h3 class="domain-title">Requirement Engineering</h3>
          <p class="domain-desc">Master IREB CPRE syllabi, EARS syntax, elicitation psychology, and end-to-end traceability to reduce scope creep and rework.</p>
          <div class="domain-tags">
            <span class="domain-chip">IREB CPRE</span>
            <span class="domain-chip">EARS Syntax</span>
            <span class="domain-chip">Traceability</span>
          </div>
          <div class="domain-action-link">
            <span>Explore RE Programs</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </div>
      </div>

      <!-- 2. Systems Engineering -->
      <div class="domain-card domain-se" onclick="window.location.href='/courses?category=Systems%20Engineering'">
        <div class="domain-card-accent"></div>
        <div class="domain-card-body">
          <div class="domain-icon-wrap">
            <span class="domain-icon-symbol">⚙️</span>
          </div>
          <span class="domain-kicker">INCOSE &amp; MBSE</span>
          <h3 class="domain-title">Systems Engineering</h3>
          <p class="domain-desc">Design resilient multidisciplinary architectures utilizing ISO 15288 standards, SysML modeling, and holistic trade-off management.</p>
          <div class="domain-tags">
            <span class="domain-chip">INCOSE ASEP</span>
            <span class="domain-chip">SysML / MBSE</span>
            <span class="domain-chip">ISO 15288</span>
          </div>
          <div class="domain-action-link">
            <span>Explore SE Programs</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </div>
      </div>

      <!-- 3. Business Analysis -->
      <div class="domain-card domain-ba" onclick="window.location.href='/courses?category=Business%20Analysis'">
        <div class="domain-card-accent"></div>
        <div class="domain-card-body">
          <div class="domain-icon-wrap">
            <span class="domain-icon-symbol">📊</span>
          </div>
          <span class="domain-kicker">IIBA BABOK Aligned</span>
          <h3 class="domain-title">Business Analysis</h3>
          <p class="domain-desc">Bridge technical architectures and executive business goals with agile requirements, user journey mapping, and value stream optimization.</p>
          <div class="domain-tags">
            <span class="domain-chip">IIBA CCBA/CBAP</span>
            <span class="domain-chip">Agile User Stories</span>
            <span class="domain-chip">Process Modeling</span>
          </div>
          <div class="domain-action-link">
            <span>Explore BA Programs</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </div>
      </div>

      <!-- 4. Automotive -->
      <div class="domain-card domain-auto" onclick="window.location.href='/courses?category=Automotive'">
        <div class="domain-card-accent"></div>
        <div class="domain-card-body">
          <div class="domain-icon-wrap">
            <span class="domain-icon-symbol">🚗</span>
          </div>
          <span class="domain-kicker">ASPICE &amp; Safety</span>
          <h3 class="domain-title">Automotive</h3>
          <p class="domain-desc">Master Automotive SPICE (SYS.2 / SWE.1), ISO 26262 functional safety, and cybersecurity compliance for ECU and software development.</p>
          <div class="domain-tags">
            <span class="domain-chip">ASPICE v3.1/4.0</span>
            <span class="domain-chip">ISO 26262</span>
            <span class="domain-chip">AUTOSAR &amp; V-Model</span>
          </div>
          <div class="domain-action-link">
            <span>Explore Automotive</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Feature Learning Paths Section (Highlighted & Animated) -->
<section class="section learning-paths-section" id="paths">
  <div class="container">
    <div class="section-hdr center">
      <span class="eyebrow">Feature Learning Paths</span>
      <h2>Find the Right Path for Where You Are Now</h2>
      <p class="lead">Structured roadmaps from foundational certifications to specialized system architecture mastery.</p>
    </div>

    <!-- Animated Path Tabs Container -->
    <div class="path-tabs-container">
      <div class="path-tabs">
        <% Object.keys(byCategory).forEach((cat, i) => { %>
          <button class="path-tab <%= i===0?'active':'' %>" onclick="showPath('<%= cat.replace(/\s+/g,'-') %>', this)">
            <span class="tab-label"><%= cat %></span>
            <span class="tab-badge"><%= byCategory[cat].length %></span>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- Path Panels Grid -->
    <div class="path-panels-wrapper">
      <% Object.keys(byCategory).forEach((cat, i) => { %>
        <div class="path-panel <%= i===0?'active':'' %>" id="path-<%= cat.replace(/\s+/g,'-') %>">
          <% byCategory[cat].forEach(c => { %>
            <div class="course-mini-card">
              <div class="mini-card-top">
                <span class="tag <%= c.certification ? 'tag-cert' : 'tag-skill' %>">
                  <%= c.certification ? '🏅 Official Certification' : '⚡ Skills Mastery' %>
                </span>
                <span class="mini-duration"><%= c.durationDays %> Day<%= c.durationDays > 1 ? 's' : '' %></span>
              </div>

              <h4 class="mini-course-title"><%= c.title %></h4>
              <p class="mini-course-summary"><%= c.summary %></p>

              <div class="mini-price-row">
                <div class="price-val-wrap">
                  <span class="price-current">$<%= (c.priceCents/100).toFixed(0) %></span>
                  <% if(c.discountPercent){ %>
                    <span class="price-discount-pill"><%= c.discountPercent %>% OFF</span>
                  <% } %>
                </div>
                <div class="seats-status-pill">
                  <span class="status-pulse-dot"></span>
                  <span>Seats Available</span>
                </div>
              </div>

              <!-- Interactive Links & Batches Elements -->
              <div class="course-mini-ctas">
                <a href="/courses/<%= c.slug %>" class="btn btn-outline btn-learn-more">
                  <span>Learn More</span>
                  <svg class="cta-arrow-slide" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
                <a href="/courses/<%= c.slug %>#sessions" class="btn btn-navy btn-batches-cta">
                  <span>Upcoming Batches</span>
                  <span class="batch-count-dot">📅</span>
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Dedicated Certificate Card Layout Section -->
