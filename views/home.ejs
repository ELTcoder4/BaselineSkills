</section>

<!-- Upcoming Programs & Live Batches Section -->
<section class="section batches-table-section" id="upcoming-batches">
  <div class="container">
    <div class="section-hdr">
      <div class="hdr-kicker-row">
        <span class="eyebrow">Upcoming Cohorts</span>
        <span class="live-cohort-chip"><span class="pulse-green"></span> Guaranteed to Run</span>
      </div>
      <h2>Secure Your Seat in the Next Cohort</h2>
      <p class="lead">Live interactive instructor-led classes with small cohorts for high engagement.</p>
    </div>

    <div class="table-card-wrap">
      <div class="table-wrap">
        <table class="programs-table-enhanced">
          <thead>
            <tr>
              <th>Course Program</th>
              <th>Learning Mode</th>
              <th>Start Date</th>
              <th>Duration</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% upcoming.forEach(s => { %>
            <tr>
              <td>
                <div class="table-course-info">
                  <strong><%= s.course.title %></strong>
                  <span class="table-cat-sub"><%= s.course.category %></span>
                </div>
              </td>
              <td><span class="pill pill-mode"><%= s.mode %></span></td>
              <td>
                <div class="table-date-cell">
                  <span class="date-icon">📅</span>
                  <span><%= s.startDate %></span>
                </div>
              </td>
              <td><strong><%= s.course.durationDays %> Day<%= s.course.durationDays>1?'s':'' %></strong></td>
              <td><span class="batch-status-tag"><span class="status-dot-orange"></span> Filling Fast</span></td>
              <td>
                <div class="table-action-btns">
                  <a href="/courses/<%= s.course.slug %>/register" class="btn btn-navy btn-sm">Register</a>
                  <a href="/courses/<%= s.course.slug %>" class="btn btn-outline btn-sm">Details</a>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

