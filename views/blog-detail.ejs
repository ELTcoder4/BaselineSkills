<%- include('partials/header') %>

<section class="course-header">
  <div class="container">
    <span class="tag"><%= post.category %></span>
    <h1 style="color:#fff;margin-top:14px"><%= post.title %></h1>
    <p style="color:rgba(255,255,255,.75);font-size:.9rem">By <%= post.author %> &middot; <%= new Date(post.createdAt).toLocaleDateString() %></p>
  </div>
</section>

<div class="container course-body">
  <div>
    <p style="white-space:pre-line;color:var(--text);line-height:1.7"><%= post.body %></p>

    <% if (related.length) { %>
    <h2 style="margin-top:36px">Related Posts</h2>
    <div class="grid-3">
      <% related.forEach(r => { %>
        <div class="card">
          <h4><%= r.title %></h4>
          <p style="font-size:.85rem;color:var(--muted);flex:1"><%= r.excerpt %></p>
          <a href="/blog/<%= r.slug %>" class="btn btn-outline btn-sm">Read More</a>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <div>
    <div class="sticky-card">
      <h4 style="margin-top:0;font-size:.95rem">Want to go deeper?</h4>
      <p style="font-size:.85rem;color:var(--muted)">Explore our courses on this topic and turn theory into a certified skill.</p>
      <a href="/courses" class="btn btn-gold btn-block">Explore Courses</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
