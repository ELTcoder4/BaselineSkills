<%- include('partials/header') %>

<section class="section-tight" style="background:#fff;border-bottom:1px solid var(--line)">
  <div class="container">
    <span class="eyebrow">RE Pulse</span>
    <h1 style="font-size:2.1rem">Free resources to sharpen your practice.</h1>
  </div>
</section>

<section class="section">
  <div class="container grid-3">
    <% articles.forEach(a => { %>
      <div class="card">
        <span class="tag"><%= a.category %></span>
        <h3 style="margin-top:12px"><%= a.title %></h3>
        <p style="color:var(--muted);font-size:.9rem;flex:1"><%= a.excerpt %></p>
        <a href="<%= a.url %>" class="btn btn-outline btn-sm">Get the full guide</a>
      </div>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
